<?xml version="1.0"?>
<launch>
  <!-- Real robot 4ch launch: camera BGR image + Mask2Former ground mask -->

  <arg name="script" default="nav_cloning_4ch_node_pytorch_online_mask.py"/>
  <arg name="map_file" default="cit_3f_map"/>
  <arg name="mode" default="change_dataset_balance"/>

  <arg name="save_offline_dataset" default="true"/>
  <arg name="save_raw_images" default="true"/>
  <arg name="dataset_id" default="real_4ch_short_test"/>
  <arg name="dataset_stride" default="1"/>
  <arg name="dataset_action_offset" default="0.2"/>

  <arg name="train_steps" default="300"/>
  <arg name="test_steps" default="100"/>
  <arg name="auto_stop_test" default="true"/>
  <arg name="auto_save_model" default="true"/>
  <arg name="auto_load_model" default="true"/>

  <arg name="cmd_vel_linear_fixed" default="0.05"/>
  <arg name="cmd_vel_mode" default="mixed"/>
  <arg name="cmd_vel_linear_source" default="fixed"/>

  <arg name="mask_max_age_sec" default="1.5"/>
  <arg name="require_fresh_mask" default="true"/>

  <!-- Mask2Former paths. Change these to your actual PC paths. -->
  <arg name="mmseg_cfg" default="/home/orne_beta/mask2former_project/mmsegmentation/configs/mask2former/mask2former_swin-s_8xb2-160k_ade20k-512x512.py"/>
  <arg name="mmseg_ckpt" default="/home/orne_beta/mask2former_project/checkpoints/mask2former_swin-s_ade20k.pth"/>
  <arg name="mmseg_device" default="cuda:0"/>
  <arg name="seg_rate_hz" default="2.0"/>
  <arg name="seg_save_pred" default="true"/>
  <arg name="seg_save_pred_interval" default="10"/>
  <arg name="ground_names" default="floor,road,sidewalk,path,earth,land,field,sand,grass,runway"/>

  <!-- Navigation args copied from existing real-robot launch style -->
  <arg name="use_waypoint_nav" default="false"/>
  <arg name="waypoints_file" default="cit3f_way.yaml"/>
  <arg name="dist_err" default="1.0"/>
  <arg name="waypoint_server_config" default="$(find waypoint_server)/config/waypoint_server_tsudanuma_2-3.yaml"/>
  <arg name="use_dynamic_inflation" default="false"/>
  <arg name="inflation_mode" default="count"/>
  <arg name="inflation_wp_small" default="10"/>
  <arg name="inflation_wp_large" default="15"/>
  <arg name="inflation_index_small" default="10"/>
  <arg name="inflation_index_large" default="0"/>
  <arg name="inflation_small" default="0.2"/>
  <arg name="inflation_large" default="0.6"/>
  <arg name="inflation_topic" default="/waypoint_manager/waypoint/is_reached"/>
  <arg name="inflation_waypoint_topic" default="/waypoint_manager/waypoint"/>
  <arg name="inflation_identity_regex" default="^wp_(\d+)$"/>
  <arg name="initial_pose_x" default="-9.44"/>
  <arg name="initial_pose_y" default="28.83"/>
  <arg name="initial_pose_a" default="3.14"/>
  <arg name="use_initpose" default="false"/>

  <!-- nav_cloning node params -->
  <param name="/nav_cloning_node/mode" value="$(arg mode)" type="str"/>
  <param name="/nav_cloning_node/save_offline_dataset" value="$(arg save_offline_dataset)" type="bool"/>
  <param name="/nav_cloning_node/save_raw_images" value="$(arg save_raw_images)" type="bool"/>
  <param name="/nav_cloning_node/dataset_id" value="$(arg dataset_id)" type="str"/>
  <param name="/nav_cloning_node/dataset_stride" value="$(arg dataset_stride)" type="int"/>
  <param name="/nav_cloning_node/dataset_action_offset" value="$(arg dataset_action_offset)" type="double"/>
  <param name="/nav_cloning_node/train_steps" value="$(arg train_steps)" type="int"/>
  <param name="/nav_cloning_node/test_steps" value="$(arg test_steps)" type="int"/>
  <param name="/nav_cloning_node/auto_stop_test" value="$(arg auto_stop_test)" type="bool"/>
  <param name="/nav_cloning_node/auto_save_model" value="$(arg auto_save_model)" type="bool"/>
  <param name="/nav_cloning_node/auto_load_model" value="$(arg auto_load_model)" type="bool"/>
  <param name="/nav_cloning_node/cmd_vel_linear_fixed" value="$(arg cmd_vel_linear_fixed)" type="double"/>
  <param name="/nav_cloning_node/cmd_vel_mode" value="$(arg cmd_vel_mode)" type="str"/>
  <param name="/nav_cloning_node/cmd_vel_linear_source" value="$(arg cmd_vel_linear_source)" type="str"/>
  <param name="/nav_cloning_node/max_mask_age_sec" value="$(arg mask_max_age_sec)" type="double"/>
  <param name="/nav_cloning_node/require_fresh_mask" value="$(arg require_fresh_mask)" type="bool"/>
  <param name="/nav_cloning_node/mask_center_topic" value="/segmentation/ground_mask_center" type="str"/>
  <param name="/nav_cloning_node/mask_left_topic" value="/segmentation/ground_mask_left" type="str"/>
  <param name="/nav_cloning_node/mask_right_topic" value="/segmentation/ground_mask_right" type="str"/>

  <group if="$(arg use_initpose)">
    <node pkg="nav_cloning" type="initpose" name="initpose"/>
  </group>

  <!-- Start Mask2Former segmentation first. -->
  <node pkg="nav_cloning"
        type="start_mmseg.sh"
        name="segmentation_colorserver"
        args="$(find nav_cloning)/scripts/segmentation_colorserver_real.py"
        output="screen">
    <param name="cfg" value="$(arg mmseg_cfg)"/>
    <param name="ckpt" value="$(arg mmseg_ckpt)"/>
    <param name="device" value="$(arg mmseg_device)"/>
    <param name="in_center_topic" value="/camera_center/usb_cam/image_raw"/>
    <param name="in_left_topic" value="/camera_left/usb_cam/image_raw"/>
    <param name="in_right_topic" value="/camera_right/usb_cam/image_raw"/>
    <param name="out_mask_center_topic" value="/segmentation/ground_mask_center"/>
    <param name="out_mask_left_topic" value="/segmentation/ground_mask_left"/>
    <param name="out_mask_right_topic" value="/segmentation/ground_mask_right"/>
    <param name="ground_names" value="$(arg ground_names)"/>
    <param name="scale_h" value="48"/>
    <param name="scale_w" value="64"/>
    <param name="rate_hz" value="$(arg seg_rate_hz)"/>
    <param name="sync_slop_sec" value="0.05"/>
    <param name="sync_queue" value="10"/>
    <param name="publish_pred_id" value="true"/>
    <param name="save_pred" value="$(arg seg_save_pred)"/>
    <param name="save_pred_interval" value="$(arg seg_save_pred_interval)"/>
  </node>

  <!-- Start nav_cloning after Mask2Former has time to initialize. -->
  <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
        args="20 nav_cloning nav_cloning.launch script:=$(arg script)"
        name="timed_roslaunch_4ch_nav_cloning" output="screen"/>

  <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
        args="25 orne_navigation_executor play_waypoints_nav_common.launch
        map_file:=$(find nav_cloning)/maps/$(arg map_file)
        use_waypoint_nav:=$(arg use_waypoint_nav)
        waypoints_file:=$(find nav_cloning)/maps/$(arg waypoints_file)
        dist_err:=$(arg dist_err)
        waypoint_server_config:=$(arg waypoint_server_config)
        initial_pose_x:=$(arg initial_pose_x)
        initial_pose_y:=$(arg initial_pose_y)
        initial_pose_a:=$(arg initial_pose_a)"
        name="timed_roslaunch_4ch_navigation" output="screen"/>

  <group if="$(arg use_dynamic_inflation)">
    <node pkg="nav_cloning" type="waypoint_inflation_switcher.py"
          name="waypoint_inflation_switcher" output="screen">
      <param name="mode" value="$(arg inflation_mode)"/>
      <param name="topic" value="$(arg inflation_topic)"/>
      <param name="waypoint_topic" value="$(arg inflation_waypoint_topic)"/>
      <param name="wp_small" value="$(arg inflation_wp_small)"/>
      <param name="wp_large" value="$(arg inflation_wp_large)"/>
      <param name="index_small" value="$(arg inflation_index_small)"/>
      <param name="index_large" value="$(arg inflation_index_large)"/>
      <param name="identity_regex" value="$(arg inflation_identity_regex)"/>
      <param name="radius_small" value="$(arg inflation_small)"/>
      <param name="radius_large" value="$(arg inflation_large)"/>
    </node>
  </group>

  <group unless="$(arg use_waypoint_nav)">
    <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
          args="45 nav_cloning start_manager_nav.launch"
          name="timed_roslaunch_4ch_start_manager" output="screen"/>
  </group>
</launch>
